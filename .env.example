# Example environment variables for AniSkolar Frontend
# COPY this file to .env and fill in real values (do NOT commit .env)

# Clerk publishable key for client-side SDK (safe-ish to publish, but rotate if leaked)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxx

# If frontend needs to reference API base URL
VITE_API_BASE_URL=http://localhost:5000
